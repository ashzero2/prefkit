PREFKIT_CONFIG=.prefkit.json
PREFKIT_STORE=~/.prefkit/prefs.db

PREFKIT_LEARNER=ollama
PREFKIT_OLLAMA_BASE_URL=http://127.0.0.1:11434
PREFKIT_OLLAMA_MODEL=qwen3:4b
PREFKIT_MODEL_TEMPERATURE=0
PREFKIT_MODEL_TIMEOUT_MS=20000

PREFKIT_LOG_LEVEL=info
PREFKIT_REDACT_SECRETS=true

# Optional hosted fallback. Disabled unless config enables remote learning.
PREFKIT_API_KEY=
PREFKIT_API_BASE_URL=
PREFKIT_API_MODEL=
